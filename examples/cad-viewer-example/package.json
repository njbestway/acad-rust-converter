{
  "name": "cad-viewer-example",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Example app: @mlightcad/cad-viewer with @njbestway/acad-rust-converter registered as the default DWG parser (WASM worker + main-thread paths)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mlightcad/cad-viewer": "1.7.6",
    "@mlightcad/cad-agent-plugin": "1.7.6",
    "@mlightcad/cad-html-plugin": "1.7.6",
    "@mlightcad/cad-pdf-plugin": "1.7.6",
    "@mlightcad/cad-simple-viewer": "1.7.6",
    "@mlightcad/cad-svg-plugin": "1.7.6",
    "@mlightcad/pdf-renderer": "1.7.6",
    "@mlightcad/data-model": "^1.15.14",
    "@njbestway/acad-rust-converter": "workspace:*",
    "element-plus": "^2.12.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-static-copy": "^4.1.1",
    "vue-tsc": "^2.1.6"
  }
}
