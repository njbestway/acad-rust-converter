# Scope-specific routing only — mirrors the cad-viewer monorepo policy: pin the
# scopes we publish/consume to the official registry so a machine-global npmmirror
# default cannot silently redirect `pnpm publish` or serve stale @mlightcad releases.
# The default `registry` / `store-dir` are intentionally NOT set here — they are
# machine/region specific and belong in each developer's global ~/.npmrc.
@njbestway:registry=https://registry.npmjs.org/
@mlightcad:registry=https://registry.npmjs.org/
